# Copy to .env and fill in. `.env` is never committed.

PORT=4000
# Where the web app runs. Links in emails and redirects after Spotify go here.
APP_URL=http://127.0.0.1:5173
DATABASE_URL=postgres://memoir:memoir@127.0.0.1:5432/memoir

# Encrypts Spotify tokens in the database. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_KEY=

# Spotify app from https://developer.spotify.com/dashboard
# Redirect URI to register there: http://127.0.0.1:5173/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Email. Leave both of these empty and emails (confirmation links) are printed in this terminal.
#
# Brevo (recommended, 300 emails a day free): sign up, verify the address you want to send from under
# "Senders, domains & dedicated IPs", then create an API key under "SMTP & API" → "API keys".
# It's an HTTPS call, so it works on networks that block the mail ports — unlike SMTP_URL.
# MAIL_FROM must be that verified address.
BREVO_API_KEY=
MAIL_FROM="Memoir <no-reply@memoir.local>"
# Any other mail server, used only when BREVO_API_KEY is empty. Brevo's own relay is
# smtp://<login>:<smtp-key>@smtp-relay.brevo.com:587
SMTP_URL=
# Check either of them with: npm run mail -- you@example.com

# Calls. STUN is enough on most home networks; TURN relays the call when a direct path can't be found.
# `npm run turn:up` starts the coturn in docker-compose.yml, which uses TURN_SECRET.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
STUN_URLS=stun:stun.l.google.com:19302,stun:127.0.0.1:3478
TURN_URL=turn:127.0.0.1:3478
TURN_SECRET=

# Production only (the host's dashboard, not this file):
#   API_URL          this server's public address, e.g. https://memoir-api.onrender.com
#   EXTRA_ORIGINS    other addresses allowed to call the API, comma separated
#   CLOUDINARY_URL   from the Cloudinary dashboard: cloudinary://<key>:<secret>@<cloud name>
# With CLOUDINARY_URL set, photos go there instead of the local uploads/ folder.
