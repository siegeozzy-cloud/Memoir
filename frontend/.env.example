# Copy to .env.local (not committed) if you need it.

# Run the app without the backend (../backend), on in-browser mock data:
# VITE_API=mock

# Where the API lives, when it isn't behind this app's /api proxy.
# Vercel sets this for the deployed app; leave it out locally.
# VITE_API_URL=https://memoir-api.onrender.com
